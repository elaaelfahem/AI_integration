{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DME structured fact extraction output",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "prompt_version", "campaign_id", "company_id", "document_checksum", "summary", "facts", "warnings"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "prompt_version": {"const": "fact-extractor-1.0"},
    "campaign_id": {"type": "string"},
    "company_id": {"type": "string"},
    "document_checksum": {"type": "string"},
    "summary": {"type": "string"},
    "facts": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "value_text", "source_url", "evidence_text", "extractor_confidence", "inferred"],
        "properties": {
          "field": {"enum": ["description", "activity", "product_service", "email", "phone", "linkedin", "facebook", "other_social", "leader", "legal_identifier", "legal_name", "address", "market", "technology", "growth_signal"]},
          "value_text": {"type": "string"},
          "source_url": {"type": "string"},
          "evidence_text": {"type": "string"},
          "extractor_confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "inferred": {"const": false}
        }
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}}
  }
}
