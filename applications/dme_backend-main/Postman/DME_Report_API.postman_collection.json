{
  "info": {
    "name": "DME Backend - Report API Checks",
    "description": "Runnable checks for the implemented DME REST API, including prospection lifecycle, field report processing, and PDF export. No secrets are stored in this collection; use the accompanying environment file.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3001" },
    { "key": "accessToken", "value": "" },
    { "key": "companyId", "value": "" },
    { "key": "agentId", "value": "" },
    { "key": "assignmentId", "value": "" },
    { "key": "meetingId", "value": "" },
    { "key": "ticketId", "value": "" }
  ],
  "item": [
    {
      "name": "Smoke and authentication",
      "item": [
        {
          "name": "GET /health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('reports healthy status', () => pm.expect(pm.response.json().status).to.eql('ok'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        },
        {
          "name": "POST /login as manager",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.expect(body.accessToken, 'access token').to.be.a('string').and.not.empty;",
                  "pm.collectionVariables.set('accessToken', body.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{managerEmail}}\",\n  \"password\": \"{{managerPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": ["{{baseUrl}}"],
              "path": ["login"]
            }
          }
        },
        {
          "name": "POST /login rejects invalid credentials",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns HTTP 401', () => pm.response.to.have.status(401));",
                  "pm.test('does not disclose credential details', () => pm.expect(pm.response.json().message).to.eql('Invalid email or password'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{managerEmail}}\",\n  \"password\": \"not-the-password\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": ["{{baseUrl}}"],
              "path": ["login"]
            }
          }
        },
        {
          "name": "GET /users/me",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('returns a manager profile', () => pm.expect(pm.response.json().role).to.eql('MANAGER'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Manager operational API",
      "item": [
        {
          "name": "GET /companies and select a company",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const rows = Array.isArray(body) ? body : body.data;",
                  "pm.expect(rows).to.be.an('array').and.not.empty;",
                  "pm.collectionVariables.set('companyId', rows[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/companies",
              "host": ["{{baseUrl}}"],
              "path": ["companies"]
            }
          }
        },
        {
          "name": "GET /users/agents and select an agent",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const rows = Array.isArray(body) ? body : body.data;",
                  "pm.expect(rows).to.be.an('array').and.not.empty;",
                  "pm.collectionVariables.set('agentId', rows[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/agents",
              "host": ["{{baseUrl}}"],
              "path": ["users", "agents"]
            }
          }
        },
        {
          "name": "GET /assignments",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json()).to.be.an('array');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/assignments",
              "host": ["{{baseUrl}}"],
              "path": ["assignments"]
            }
          }
        },
        {
          "name": "POST /assignments",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns a successful assignment response', () => pm.expect(pm.response.code).to.be.oneOf([200, 201])) ;",
                  "const body = pm.response.json();",
                  "pm.expect(body.id, 'assignment id').to.be.a('string').and.not.empty;",
                  "pm.collectionVariables.set('assignmentId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"companyId\": \"{{companyId}}\",\n  \"agentId\": \"{{agentId}}\",\n  \"scheduledAt\": \"{{$isoTimestamp}}\",\n  \"durationMinutes\": 60,\n  \"visitType\": \"FIRST_VISIT\",\n  \"priority\": \"MEDIUM\",\n  \"objectives\": \"Postman API validation visit\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/assignments",
              "host": ["{{baseUrl}}"],
              "path": ["assignments"]
            }
          }
        },
        {
          "name": "PATCH /assignments/:id cancel",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns a successful update response', () => pm.expect(pm.response.code).to.be.oneOf([200, 204]));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CANCELLED\",\n  \"cancellationReason\": \"Postman validation cleanup\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/assignments/{{assignmentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["assignments", "{{assignmentId}}"]
            }
          }
        },
        {
          "name": "GET /meetings",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json()).to.be.an('array');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/meetings",
              "host": ["{{baseUrl}}"],
              "path": ["meetings"]
            }
          }
        },
        {
          "name": "POST /meetings",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns a successful meeting response', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "const body = pm.response.json();",
                  "pm.expect(body.id, 'meeting id').to.be.a('string').and.not.empty;",
                  "pm.collectionVariables.set('meetingId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"companyId\": \"{{companyId}}\",\n  \"agentId\": \"{{agentId}}\",\n  \"title\": \"Postman validation meeting\",\n  \"agenda\": \"Validate prospecting meeting scheduling\",\n  \"scheduledAt\": \"{{$isoTimestamp}}\",\n  \"durationMinutes\": 60,\n  \"visitType\": \"FIRST_VISIT\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/meetings",
              "host": ["{{baseUrl}}"],
              "path": ["meetings"]
            }
          }
        },
        {
          "name": "GET /tickets",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json()).to.be.an('array');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/tickets",
              "host": ["{{baseUrl}}"],
              "path": ["tickets"]
            }
          }
        },
        {
          "name": "POST /tickets",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns HTTP 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.expect(body.id, 'ticket id').to.be.a('string').and.not.empty;",
                  "pm.collectionVariables.set('ticketId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"TECHNICAL\",\n  \"subject\": \"Postman validation ticket\",\n  \"description\": \"Validation ticket created by the runnable API collection.\",\n  \"priority\": \"LOW\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tickets",
              "host": ["{{baseUrl}}"],
              "path": ["tickets"]
            }
          }
        },
        {
          "name": "GET /tickets/:id detail and history",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.expect(body.id).to.eql(pm.collectionVariables.get('ticketId'));",
                  "pm.expect(body).to.have.property('status');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/tickets/{{ticketId}}",
              "host": ["{{baseUrl}}"],
              "path": ["tickets", "{{ticketId}}"]
            }
          }
        },
        {
          "name": "POST /tickets/:id/replies",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns a successful reply response', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Postman validation reply\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tickets/{{ticketId}}/replies",
              "host": ["{{baseUrl}}"],
              "path": ["tickets", "{{ticketId}}", "replies"]
            }
          }
        }
      ]
    },
    {
      "name": "PDF report endpoint probes",
      "description": "These checks exercise the persisted prospection lifecycle, original field report, structured result, and PDF export.",
      "item": [
        {
          "name": "POST /prospections/:id/update",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns a successful response', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "pm.expect(pm.response.json().status).to.eql('VISITED');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"VISITED\",\n  \"notes\": \"Anonymized report evidence\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/prospections/{{assignmentId}}/update",
              "host": ["{{baseUrl}}"],
              "path": ["prospections", "{{assignmentId}}", "update"]
            }
          }
        },
        {
          "name": "POST /reports/:id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json().processing.verdict).to.be.a('string');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"summary\": \"Anonymized field report\",\n  \"needs\": \"Connectivity\",\n  \"outcome\": \"Follow-up\",\n  \"nextAction\": \"Schedule technical workshop\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/reports/{{assignmentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["reports", "{{assignmentId}}"]
            }
          }
        },
        {
          "name": "GET /reports/:id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json().original_payload).to.be.an('object');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/reports/{{assignmentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["reports", "{{assignmentId}}"]
            }
          }
        },
        {
          "name": "GET /reports/:id/export",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.headers.get('Content-Type')).to.include('application/pdf');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/reports/{{assignmentId}}/export",
              "host": ["{{baseUrl}}"],
              "path": ["reports", "{{assignmentId}}", "export"]
            }
          }
        }
      ]
    }
  ]
}
