DATABASE_URL=postgresql://user:password@host/database?sslmode=verify-full
PORT=3001
HOST=127.0.0.1

MAIL_HOST=localhost
MAIL_PORT=1025

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
COOKIE_SECURE=false
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
EMAIL_DOMAIN_WHITELIST=*
SESSION_IDLE_TIMEOUT_MS=900000
TOUCH_INTERVAL_MS=60000
PASSWORD_RESET_EMAIL_LIMIT=3
PASSWORD_RESET_EMAIL_WINDOW_MS=900000

SUPERADMIN_EMAIL="admin123@example.com"
SUPERADMIN_PASSWORD="SecurePassword123!"
SUPERADMIN_FIRST_NAME="Super"
SUPERADMIN_LAST_NAME="Admin"
SUPERADMIN_PHONE="+216 20 123 456"

# Firebase Admin (push notifications): base64 of the service account JSON
FIREBASE_SERVICE_ACCOUNT=

# Server-only AI services. Never put these URLs or tokens in NEXT_PUBLIC variables.
AI_N8N_URL=http://127.0.0.1:5678
# Lets each prospecting search skip companies already found. Optional.
AI_DISCOVERY_URL=http://127.0.0.1:8080
AI_ASSISTANT_URL=http://127.0.0.1:8085
AI_REPORT_CLEANER_URL=http://127.0.0.1:8086
AI_ENABLE_MODEL=true
AI_SERVICE_TOKEN=

AI_RISK_URL=http://127.0.0.1:8087
